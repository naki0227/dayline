{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dayline.dev/contracts/action-proposal.schema.json",
  "title": "ActionProposal",
  "description": "An unexecuted external side effect awaiting deterministic policy evaluation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "proposed_at",
    "expires_at",
    "state",
    "source_artifact_ids",
    "supporting_event_ids",
    "tool",
    "arguments_schema",
    "arguments",
    "effect",
    "target",
    "risk",
    "permission",
    "sensitivity",
    "idempotency_key",
    "rationale",
    "proposer"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "format": "uuid" },
    "proposed_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": ["string", "null"], "format": "date-time" },
    "state": { "const": "proposed" },
    "source_artifact_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "format": "uuid" }
    },
    "supporting_event_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "format": "uuid" }
    },
    "tool": { "$ref": "#/$defs/tool" },
    "arguments_schema": { "$ref": "#/$defs/versioned_identifier" },
    "arguments": { "type": "object" },
    "effect": { "enum": ["create", "update", "delete", "send", "publish", "schedule"] },
    "target": { "$ref": "#/$defs/target" },
    "risk": { "$ref": "#/$defs/risk" },
    "permission": { "$ref": "#/$defs/permission" },
    "sensitivity": { "enum": ["standard", "sensitive", "restricted"] },
    "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 200 },
    "rationale": { "type": "string", "minLength": 1 },
    "proposer": { "$ref": "#/$defs/proposer" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "risk": {
            "properties": { "destructive": { "const": true } },
            "required": ["destructive"]
          }
        },
        "required": ["risk"]
      },
      "then": {
        "properties": {
          "permission": {
            "properties": { "confirmation": { "const": "required" } }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "effect": { "const": "delete" } },
        "required": ["effect"]
      },
      "then": {
        "properties": {
          "risk": {
            "properties": { "destructive": { "const": true } }
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]*$"
    },
    "versioned_identifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["integration", "name", "operation"],
      "properties": {
        "integration": { "$ref": "#/$defs/identifier" },
        "name": { "$ref": "#/$defs/identifier" },
        "operation": { "$ref": "#/$defs/identifier" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "identifier", "display_name"],
      "properties": {
        "type": { "$ref": "#/$defs/identifier" },
        "identifier": { "type": "string", "minLength": 1 },
        "display_name": { "type": ["string", "null"] }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "destructive", "reasons"],
      "properties": {
        "level": { "enum": ["low", "medium", "high"] },
        "destructive": { "type": "boolean" },
        "reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_scopes", "confirmation"],
      "properties": {
        "required_scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "confirmation": { "enum": ["required", "policy_decides"] }
      }
    },
    "proposer": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "runtime", "model", "prompt_id", "prompt_version", "run_id"],
          "properties": {
            "type": { "const": "model" },
            "runtime": { "type": "string", "minLength": 1 },
            "model": { "type": "string", "minLength": 1 },
            "prompt_id": { "$ref": "#/$defs/identifier" },
            "prompt_version": { "type": "integer", "minimum": 1 },
            "run_id": { "type": "string", "format": "uuid" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "rule_id", "rule_version"],
          "properties": {
            "type": { "const": "rule" },
            "rule_id": { "$ref": "#/$defs/identifier" },
            "rule_version": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    }
  }
}
