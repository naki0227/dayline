{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dayline.dev/contracts/semantic-artifact.schema.json",
  "title": "SemanticArtifact",
  "description": "Versioned model-derived meaning traceable to observed context events.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "created_at",
    "day_id",
    "session_id",
    "kind",
    "content",
    "source_event_ids",
    "source_artifact_ids",
    "confidence",
    "sensitivity",
    "retention",
    "generation"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "format": "uuid" },
    "created_at": { "type": "string", "format": "date-time" },
    "day_id": { "$ref": "#/$defs/day_id" },
    "session_id": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "kind": {
      "enum": [
        "summary",
        "decision",
        "action_item",
        "idea",
        "question",
        "topic",
        "entity",
        "external"
      ]
    },
    "content": { "$ref": "#/$defs/content" },
    "source_event_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "format": "uuid" }
    },
    "source_artifact_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "format": "uuid" }
    },
    "confidence": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    },
    "sensitivity": {
      "enum": ["standard", "sensitive", "restricted"]
    },
    "retention": { "$ref": "#/$defs/retention" },
    "generation": { "$ref": "#/$defs/generation" }
  },
  "anyOf": [
    { "properties": { "source_event_ids": { "minItems": 1 } } },
    { "properties": { "source_artifact_ids": { "minItems": 1 } } }
  ],
  "$defs": {
    "day_id": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local_date", "timezone"],
      "properties": {
        "local_date": { "type": "string", "format": "date" },
        "timezone": { "type": "string", "minLength": 1 }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "attributes"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "attributes": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "retention": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "enum": ["session", "indefinite"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "days"],
          "properties": {
            "type": { "const": "days" },
            "days": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        }
      ]
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime",
        "model",
        "prompt_id",
        "prompt_version",
        "run_id",
        "generated_at"
      ],
      "properties": {
        "runtime": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "prompt_id": { "type": "string", "minLength": 1 },
        "prompt_version": { "type": "integer", "minimum": 1 },
        "run_id": { "type": "string", "format": "uuid" },
        "generated_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
