{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dayline-notion-oauth-broker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "workers_dev": true,
  "vars": {
    "DAYLINE_CALLBACK_URL": "dayline://oauth/notion",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "OAUTH_SESSIONS",
        "class_name": "OAuthSession",
      },
      {
        "name": "OAUTH_RATE_LIMITS",
        "class_name": "OAuthRateLimiter",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OAuthSession", "OAuthRateLimiter"],
    },
  ],
  "secrets": {
    "required": ["NOTION_CLIENT_SECRET", "RATE_LIMIT_KEY_SECRET"],
  },
}
